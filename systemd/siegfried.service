[Unit]
Description=Siegfried Daemon — Asistente Personal y Mayordomo Estratégico
Documentation=file:///media/okami/Mio/Siegfried/SPECIFICATION.md
After=graphical-session.target pipewire.service

[Service]
Type=simple
ExecStart=%h/.siegfried/bin/siegfried-daemon
Restart=always
RestartSec=2s
Environment=PYTHONUNBUFFERED=1

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.siegfried /run/user/%U

[Install]
WantedBy=default.target
